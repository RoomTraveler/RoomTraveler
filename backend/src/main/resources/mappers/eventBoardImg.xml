<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.trip.event.dao.EventBoardImgDao">

    <!-- 고아 이미지(게시글과 연결되지 않은 이미지) 찾기 -->
    <select id="findUnmappedImages" resultType="com.ssafy.trip.event.model.EventBoardImg">
        SELECT i.img_id, i.event_id, i.img_url, i.created_at
        FROM event_board_img i
                 LEFT JOIN event_board b ON i.event_id = b.event_id
        WHERE b.event_id IS NULL
    </select>

    <!-- 이미지 한 개 삭제 -->
    <delete id="deleteImageById" parameterType="long">
        DELETE FROM event_board_img WHERE img_id = #{imgId}
    </delete>

</mapper>
