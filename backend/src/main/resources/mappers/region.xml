<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
         "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.trip.region.dao.RegionDAO">

  <!-- 시도 매핑 -->
  <resultMap id="SidoMap" type="com.ssafy.trip.region.model.Sido">
    <result property="name" column="sido_name"/>
    <result property="code" column="sido_code"/>
  </resultMap>
  
  <!-- 모든 시도 목록 조회 -->
  <select id="getSidos" resultMap="SidoMap">
    SELECT DISTINCT sido_name, sido_code FROM sidos
  </select>

  <!-- 구군 매핑 -->
  <resultMap id="GugunMap" type="com.ssafy.trip.region.model.Gugun">
    <result property="name" column="gugun_name"/>
    <result property="code" column="gugun_code"/>
    <result property="sidoCode" column="sido_code"/>
  </resultMap>
  
  <!-- 특정 시도에 속한 구군 목록 조회 -->
  <select id="getGuguns" resultMap="GugunMap">
    SELECT DISTINCT gugun_name, gugun_code, sido_code
    FROM guguns
    WHERE sido_code = #{sidoCode}
  </select>

</mapper>