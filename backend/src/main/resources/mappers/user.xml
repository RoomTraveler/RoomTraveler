<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ssafy.trip.user.UserDao">

    <!-- 새 사용자 등록 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="userId">
        <choose>
            <when test="userId != null">
                INSERT INTO users (user_id, username, email, password, phone, role, status)
                VALUES (#{userId}, #{username}, #{email}, #{password}, #{phone}, #{role}, #{status})
            </when>
            <otherwise>
                INSERT INTO users (username, email, password, phone, role, status)
                VALUES (#{username}, #{email}, #{password}, #{phone}, 'USER', 'ACTIVE')
            </otherwise>
        </choose>
    </insert>

    <!-- 로그인 -->
    <select id="login" resultMap="userMap">
        SELECT * FROM users WHERE email = #{email} AND status = 'ACTIVE'
    </select>

    <!-- 이메일로 사용자 ID 찾기 -->
    <select id="findUserIdByEmail" resultType="long">
        SELECT user_id FROM users WHERE email = #{email}
    </select>

    <resultMap id="userMap" type="com.ssafy.trip.user.User">
        <id property="userId" column="user_id" />
        <result property="username" column="username" />
        <result property="email" column="email" />
        <result property="password" column="password" />
        <result property="phone" column="phone" />
        <result property="role" column="role" />
        <result property="status" column="status" />
        <result property="createdAt" column="created_at" />
        <result property="updatedAt" column="updated_at" />
    </resultMap>
    <select id="getUserByEmail" resultMap="userMap">
        SELECT * FROM users WHERE email = #{email}
    </select>

    <!-- 모든 사용자 조회 -->
    <select id="getUsers" resultType="com.ssafy.trip.user.User">
        SELECT * FROM users
    </select>

    <!-- 사용자 정보 업데이트 -->
    <update id="updateUser">
        UPDATE users
        SET username = #{username}
        <if test="password != null">
            , password = #{password}
        </if>
        WHERE email = #{email}
    </update>

    <!-- 사용자 삭제 -->
    <delete id="deleteUser">
        DELETE FROM users WHERE email = #{email}
    </delete>

    <!-- 비밀번호 찾기 -->
    <select id="findPassword" resultType="String">
        SELECT password FROM users
        WHERE username = #{username} AND email = #{email}
    </select>

    <update id="updateUserRole">
        UPDATE users
        SET role = #{role}
        WHERE user_id = #{userId}
    </update>

    <update id="updateUserStatus">
        UPDATE users
        SET status = #{status}
        WHERE user_id = #{userId}
    </update>

    <update id="updateUserRefreshToken">
        UPDATE users
        SET refresh = #{refreshToken}
        WHERE user_id = #{userId}
    </update>

</mapper>
